+- (void) showTrueCloudAnimated:(BOOL)animated {
+    Class panel = NSClassFromString(@"TrueCloudPanel");
+    if (panel == nil) {
+        [self trueCloudHideCover];
+        return;
+    }
+    // At launch Moonlight re-checks its saved host behind a loading frame, presented on top of everything and
+    // dismissed about 10 s later (when the host turns out to be offline). A panel presented over that frame
+    // would be dismissed with it, so take the frame down first.
+    if ([_loadingFrame isShown]) {
+        [self hideLoadingFrame:^{
+            [self showTrueCloudAnimated:animated];
+        }];
+        return;
+    }
+    _trueCloudPanelUp = YES;
+    UIViewController* controller = ((UIViewController* (*)(id, SEL))objc_msgSend)(panel, NSSelectorFromString(@"makeViewController"));
+    [[self activeViewController] presentViewController:controller animated:animated completion:^{
+        [self trueCloudHideCover];
+    }];
+}
