+- (BOOL) trueCloudHost:(TemporaryHost*)host matchesAddress:(NSString*)address {
+    return [host.address isEqualToString:address] || [host.activeAddress isEqualToString:address] ||
+           [host.localAddress isEqualToString:address] || [host.externalAddress isEqualToString:address];
