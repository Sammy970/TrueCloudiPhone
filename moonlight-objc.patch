+// Requested by the TrueCloud panel's Play button: add the cloud PC if needed, pair (the PIN is
+// submitted automatically), then auto-launch "Desktop".
+- (void) trueCloudConnectToAddress:(NSString*)address {
+    NSLog(@"[TrueCloud] connect requested for %@ (%lu known hosts)", address, (unsigned long)hostList.count);
+    if (address.length == 0) {
+        return;
+    }
+    _trueCloudLaunchAddress = address;
+    [self trueCloudShowCover:@"Connecting to your cloud PC"];
+
+    TemporaryHost* existing = nil;
+    @synchronized(hostList) {
+        for (TemporaryHost* host in hostList) {
+            if ([self trueCloudHost:host matchesAddress:address]) {
+                existing = host;
+                break;
+            }
+        }
+    }
+    if (existing != nil) {
+        NSLog(@"[TrueCloud] using saved host %@ (state %d, pair state %d)", existing.name, existing.state, existing.pairState);
+        // The saved state is stale: discovery is stopped while the panel covers us, and the host was last seen
+        // offline if the PC was off. hostClicked turns a tap on a host that isn't online into a long press (a
+        // menu) or waits for discovery, so ask the PC itself first.
+        TemporaryHost* saved = existing;
+        [self showLoadingFrame:^{
+            dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+                // Plain HTTP (no pinned certificate): it answers with the PC's state and its HTTPS port in one go.
+                // With the certificate, Moonlight first looks up the HTTPS port itself, and a failure there
+                // reads as "Host is unreachable".
+                // Ask the gateway address Play was given: the saved host's own active address is the rig's private
+                // LAN address (192.168.0.x:47989), which only works inside TrueCloud's network.
+                HttpManager* hMan = [[HttpManager alloc] initWithAddress:address httpsPort:0 serverCert:nil];
+                ServerInfoResponse* serverInfoResp = [[ServerInfoResponse alloc] init];
+                [self->_discMan pauseDiscoveryForHost:saved];
+                [hMan executeRequestSynchronously:[HttpRequest requestForResponse:serverInfoResp withUrlRequest:[hMan newHttpServerInfoRequest:false]]];
+                [self->_discMan resumeDiscoveryForHost:saved];
+                NSLog(@"[TrueCloud] probing %@ → %@", address, [serverInfoResp isStatusOk] ? @"ok" : serverInfoResp.statusMessage);
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    NSLog(@"[TrueCloud] saved host check → %@", [serverInfoResp isStatusOk] ? @"online" : serverInfoResp.statusMessage);
+                    [self hideLoadingFrame:^{
+                        if (![serverInfoResp isStatusOk]) {
+                            [self trueCloudFailedToReach:serverInfoResp.statusMessage];
+                            return;
+                        }
+                        // Don't copy this answer into the host: over plain HTTP the PC reports every client as
+                        // unpaired, which would make Moonlight pair again. hostClicked reads the real pair state over HTTPS.
+                        // The HTTPS port is the one thing to take from it: the saved host carries a stale default and
+                        // Moonlight would send its secure request to a port the gateway doesn't open.
+                        TemporaryHost* answered = [[TemporaryHost alloc] init];
+                        [serverInfoResp populateHost:answered];
+                        if (answered.httpsPort != 0) {
+                            saved.httpsPort = answered.httpsPort;
+                        }
+                        NSLog(@"[TrueCloud] https port %u", (unsigned)saved.httpsPort);
+                        // Stream and talk to the PC through the gateway, never through its private LAN address.
+                        saved.address = address;
+                        saved.activeAddress = address;
+                        saved.localAddress = nil;
+                        saved.state = StateOnline;
+                        // Moonlight's own record can say "paired" after the PC was unpaired (Unpair All, or a fresh
+                        // PC), and its fast path trusts it: the app list then fails with "not authorized". Make it
+                        // ask the PC, which pairs again by itself if it has to.
+                        saved.pairState = PairStateUnknown;
+                        [self hostClicked:saved view:self.view];
+                    }];
+                });
+            });
+        }];
+        return;
+    }
+    NSLog(@"[TrueCloud] adding host %@", address);
+
+    [self showLoadingFrame:^{
+        dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0), ^{
+            [self->_discMan discoverHost:address withCallback:^(TemporaryHost* host, NSString* error) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    NSLog(@"[TrueCloud] discover %@ → %@", address, host != nil ? host.name : error);
+                    [self hideLoadingFrame:^{
+                        if (host == nil) {
+                            // The PC is already saved under its other gateway address (a2 / a4). Discovery has just
+                            // merged this address into that host, so it matches now: go round once more.
+                            if ([error isEqualToString:@"Host information updated"] && !self->_trueCloudRetried) {
+                                self->_trueCloudRetried = YES;
+                                [self trueCloudConnectToAddress:address];
+                                return;
+                            }
+                            [self trueCloudFailedToReach:error];
+                            return;
+                        }
+                        @synchronized(hostList) {
+                            [hostList addObject:host];
+                        }
+                        [self updateHosts];
+                        [self hostClicked:host view:self.view];
+                    }];
+                });
+            }];
+        });
+    }];
 }
 
