# Copy to scripts/renew.env (git-ignored) and fill in.
TEAM_ID=ABCDE12345                 # Xcode → Settings → Accounts → your team
BUNDLE_ID=com.yourname.moonlight   # the bundle ID you build with
# DEVICE="My iPhone"               # optional: device name; defaults to the first available iPhone
# MOONLIGHT=../moonlight-ios       # optional: path to the moonlight-ios checkout
